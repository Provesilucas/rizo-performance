# ==========================================================================
# RIZO Performance — Variáveis de ambiente
# ==========================================================================
# Copie este arquivo para `.env.local` e ajuste os valores.
# --------------------------------------------------------------------------

# Provider de dados: "mock" (padrão) ou "api"
# - mock: usa os dados simulados em /src/mocks (nenhum backend necessário)
# - api:  consome o sistema oficial da RIZO via API REST
NEXT_PUBLIC_DATA_PROVIDER=mock

# URL base da API oficial da RIZO (usada apenas quando DATA_PROVIDER=api)
NEXT_PUBLIC_API_BASE_URL=https://api.rizo.com.br/v1

# Token/Chave de autenticação da API (Bearer). Mantenha em segredo.
# Em produção, prefira injetar via painel da Vercel (Environment Variables).
RIZO_API_TOKEN=

# Timeout das requisições à API, em milissegundos
NEXT_PUBLIC_API_TIMEOUT=15000
